{
  "name": "vsturbo",
  "displayName": "VS Turbo",
  "description": "VS Turbo — Diagnose and reduce latency in navigation/search workflows, warmup projects, and local indexing.",
  "version": "0.4.3",
  "publisher": "kcevib",
  "icon": "resources/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "VS Turbo operates in a restricted mode in untrusted workspaces: external child process execution (ripgrep, git CLI) is disabled, falling back to pure JavaScript search and built-in VS Code APIs."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsturbo-container",
          "title": "VS Turbo",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "vsturbo-container": [
        {
          "type": "webview",
          "id": "vsturbo.dashboardView",
          "name": "VS Turbo Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "vsturbo.openDashboard",
        "title": "VS Turbo: Open Dashboard",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.analyzeWorkspace",
        "title": "VS Turbo: Analyze Workspace Diagnostics",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.applyAllRecommendations",
        "title": "VS Turbo: Approve All Recommendations",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.runBenchmark",
        "title": "VS Turbo: Run Latency Benchmark",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.cancelBenchmark",
        "title": "VS Turbo: Cancel Latency Benchmark",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.warmupProject",
        "title": "VS Turbo: Warmup Project",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.pauseWarmup",
        "title": "VS Turbo: Pause Warmup",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.resumeWarmup",
        "title": "VS Turbo: Resume Warmup",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.rebuildIndex",
        "title": "VS Turbo: Rebuild Project Index",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.clearIndex",
        "title": "VS Turbo: Clear Index",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.pauseIndexing",
        "title": "VS Turbo: Pause Indexing",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.resumeIndexing",
        "title": "VS Turbo: Resume Indexing",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.quickSearch",
        "title": "VS Turbo: Fast Quick Search",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.searchEverywhere",
        "title": "VS Turbo: Search Everywhere",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.searchClass",
        "title": "VS Turbo: Search Class",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.searchFile",
        "title": "VS Turbo: Search File",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.searchSymbol",
        "title": "VS Turbo: Search Symbol",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.searchText",
        "title": "VS Turbo: Search Text",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.searchClasses",
        "title": "VS Turbo: Search Classes",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.searchFiles",
        "title": "VS Turbo: Search Files",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.searchSymbols",
        "title": "VS Turbo: Search Symbols",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.searchActions",
        "title": "VS Turbo: Search Actions",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.configureSearchShortcuts",
        "title": "VS Turbo: Configure Search Shortcuts",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.fastDefinition",
        "title": "VS Turbo: Fast Go to Definition",
        "category": "VS Turbo"
      },
      {
        "command": "vsturbo.fastReferences",
        "title": "VS Turbo: Fast Find References",
        "category": "VS Turbo"
      }
    ],
    "configuration": {
      "title": "VS Turbo",
      "properties": {
        "vsturbo.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable VS Turbo extension."
        },
        "vsturbo.logging.level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "VS Turbo logging level."
        },
        "vsturbo.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable workspace performance diagnostics."
        },
        "vsturbo.diagnostics.slowThresholdMs": {
          "type": "number",
          "default": 500,
          "description": "Threshold in ms to flag navigation requests as slow."
        },
        "vsturbo.index.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local symbol and file indexing."
        },
        "vsturbo.index.generatedFiles": {
          "type": "boolean",
          "default": false,
          "description": "Whether to index generated files."
        },
        "vsturbo.index.maxFileSizeBytes": {
          "type": "number",
          "default": 1048576,
          "description": "Maximum file size to index in bytes (default 1MB)."
        },
        "vsturbo.warmup.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable background project warmup."
        },
        "vsturbo.warmup.onStartup": {
          "type": "boolean",
          "default": true,
          "description": "Run warmup automatically on workspace startup."
        },
        "vsturbo.warmup.concurrency": {
          "type": "number",
          "default": 2,
          "description": "Concurrent files to warm up in background."
        },
        "vsturbo.warmup.useGitChanges": {
          "type": "boolean",
          "default": true,
          "description": "Prioritize git changed files during warmup."
        },
        "vsturbo.warmup.useRecentFiles": {
          "type": "boolean",
          "default": true,
          "description": "Prioritize recently visited files during warmup."
        },
        "vsturbo.search.useRipgrep": {
          "type": "boolean",
          "default": true,
          "description": "Use ripgrep for fast text search."
        },
        "vsturbo.navigation.mode": {
          "type": "string",
          "enum": [
            "native",
            "hybrid",
            "vsturbo",
            "codepulse"
          ],
          "default": "native",
          "description": "Navigation engine mode."
        },
        "vsturbo.navigation.trackHistory": {
          "type": "boolean",
          "default": true,
          "description": "Record navigation history for predictive warmup."
        },
        "vsturbo.search.dialogMode": {
          "type": "string",
          "enum": [
            "floatingDialog",
            "editorTab"
          ],
          "default": "floatingDialog",
          "description": "Presentation mode for Search Everywhere: 'floatingDialog' (Android Studio-style floating top-center dialog overlay, recommended) or 'editorTab' (Webview tab)."
        },
        "vsturbo.search.useNativeQuickPick": {
          "type": "boolean",
          "default": true,
          "description": "Use native VS Code floating QuickPick dialog (Android Studio style) instead of editor tab Webview."
        },
        "vsturbo.search.keymap": {
          "type": "string",
          "enum": [
            "off",
            "androidStudio"
          ],
          "default": "androidStudio",
          "description": "Android Studio-compatible search shortcuts (Cmd+O on macOS / Ctrl+O on Windows, Ctrl+Shift+N, Ctrl+Alt+Shift+N, etc.)."
        },
        "vsturbo.search.defaultMode": {
          "type": "string",
          "enum": [
            "all",
            "class",
            "file",
            "symbol",
            "text"
          ],
          "default": "all",
          "description": "Default search mode when opening Search Everywhere."
        }
      }
    },
    "keybindings": [
      {
        "command": "vsturbo.searchEverywhere",
        "key": "ctrl+o",
        "mac": "cmd+o"
      },
      {
        "command": "vsturbo.searchEverywhere",
        "key": "ctrl+shift+alt+f",
        "mac": "cmd+shift+alt+f"
      },
      {
        "command": "vsturbo.searchClass",
        "key": "ctrl+n",
        "mac": "cmd+o",
        "when": "config.vsturbo.search.keymap == 'androidStudio'"
      },
      {
        "command": "vsturbo.searchFile",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+o",
        "when": "config.vsturbo.search.keymap == 'androidStudio'"
      },
      {
        "command": "vsturbo.searchSymbol",
        "key": "ctrl+alt+shift+n",
        "mac": "cmd+alt+o",
        "when": "config.vsturbo.search.keymap == 'androidStudio'"
      },
      {
        "command": "vsturbo.searchText",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "config.vsturbo.search.keymap == 'androidStudio'"
      },
      {
        "command": "vsturbo.searchActions",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "config.vsturbo.search.keymap == 'androidStudio'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "compile": "tsc -p ./ --noEmit",
    "watch:tsc": "tsc -w -p ./ --noEmit",
    "build": "node esbuild.js",
    "build:prod": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "npm run compile && npm run test:unit",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "prettier": "^3.9.9",
    "typescript": "^5.5.2",
    "vitest": "^4.1.11"
  }
}
